# ========================================================
# ReuseHub — Resource Sharing Platform
# Environment Variables Example
# ========================================================

# Backend Configuration (backend/.env)
PORT=5000
NODE_ENV=development

# MongoDB Database Connection
# Local MongoDB: mongodb://localhost:27017/reusehub
# MongoDB Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/reusehub?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/reusehub

# JWT Secret & Expiry
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_EXPIRES_IN=7d

# CORS Allowed Origin
CLIENT_URL=http://localhost:5173

# Frontend Configuration (frontend/.env)
VITE_API_URL=http://localhost:5000/api
