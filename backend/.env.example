# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (MongoDB Atlas or Local MongoDB)
# Example Atlas URI: mongodb+srv://<username>:<password>@cluster0.mongodb.net/reusehub?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/reusehub

# JWT Authentication Secret
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_EXPIRES_IN=7d

# Frontend Client URL (for CORS)
CLIENT_URL=http://localhost:5173
